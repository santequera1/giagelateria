{
  "expo": {
    "name": "Gia Gelatería",
    "slug": "gia-gelateria",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "giagelateria",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.giagelateria.app"
    },
    "android": {
      "package": "com.giagelateria.app"
    },
    "web": {
      "output": "static"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "reactCompiler": true
    }
  }
}
